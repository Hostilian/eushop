# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=eushop_dev
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=eushop_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Get these from your Auth0 tenant dashboard → Applications → your app
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
# All of the following are REQUIRED by apps/web/lib/auth0.ts — it fails closed if any is unset.
AUTH0_BASE_URL=http://localhost:3002
AUTH0_ISSUER_BASE_URL=https://your-tenant.eu.auth0.com
# Session-cookie signing key. Generate a strong random value, e.g. `openssl rand -hex 32`.
# Never commit a real value or reuse the same secret across environments.
SESSION_SECRET=generate_a_32_byte_random_hex_string

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Public key: safe to expose to the browser (used by Stripe.js / React Stripe)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
# Secret key: server-side ONLY — never expose to the browser
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret: get from `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
# In production, set this from your Stripe Dashboard → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Core Service (Spring Boot) ──────────────────────────────────────────────
SERVER_PORT=3001

# ─── Node Environment (Next.js) ──────────────────────────────────────────────
NODE_ENV=development
