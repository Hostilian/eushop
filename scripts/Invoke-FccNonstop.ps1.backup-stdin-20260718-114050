[CmdletBinding()]
param(
    [string]$ProjectPath = "D:\CODING\eushop",
    [int]$MaximumBackoffSeconds = 900
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Continue"

function Write-RunnerLog {
    param(
        [string]$Message,
        [ValidateSet("INFO", "WARN", "ERROR", "SUCCESS")][string]$Level = "INFO"
    )

    $Now = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $Line = "[$Now][$Level] $Message"
    Add-Content -LiteralPath $script:RunnerLogPath -Value $Line

    switch ($Level) {
        "WARN"    { Write-Host $Line -ForegroundColor Yellow }
        "ERROR"   { Write-Host $Line -ForegroundColor Red }
        "SUCCESS" { Write-Host $Line -ForegroundColor Green }
        default   { Write-Host $Line }
    }
}

function Get-BackoffSeconds {
    param(
        [int]$FailureNumber,
        [int]$MaximumSeconds
    )

    $Exponent = [Math]::Min([Math]::Max($FailureNumber - 1, 0), 8)
    $Seconds = [int](30 * [Math]::Pow(2, $Exponent))
    return [Math]::Min($Seconds, $MaximumSeconds)
}

function Test-ProcessAlive {
    param([int]$ProcessId)

    if ($ProcessId -le 0) {
        return $false
    }

    return $null -ne (Get-Process -Id $ProcessId -ErrorAction SilentlyContinue)
}

if (-not (Test-Path -LiteralPath $ProjectPath -PathType Container)) {
    throw "Project path does not exist: $ProjectPath"
}

Set-Location -LiteralPath $ProjectPath

$ClaudeDirectory = Join-Path $ProjectPath ".claude"
$LogDirectory = Join-Path $ClaudeDirectory "runner-logs"
$StatePath = Join-Path $ClaudeDirectory "RECOVERY_STATE.md"
$CompletePath = Join-Path $ClaudeDirectory "AUTONOMOUS_COMPLETE"
$StopPath = Join-Path $ClaudeDirectory "AUTONOMOUS_STOP"
$LockPath = Join-Path $ClaudeDirectory "AUTONOMOUS_RUNNER.lock"

New-Item -ItemType Directory -Path $LogDirectory -Force | Out-Null
$script:RunnerLogPath = Join-Path $LogDirectory ("runner-fixed-" + (Get-Date -Format "yyyyMMdd-HHmmss") + ".log")

if (Test-Path -LiteralPath $LockPath) {
    $ExistingText = Get-Content -LiteralPath $LockPath -Raw -ErrorAction SilentlyContinue
    $ExistingPid = 0

    if ([int]::TryParse(($ExistingText -replace "\D", ""), [ref]$ExistingPid)) {
        if (Test-ProcessAlive -ProcessId $ExistingPid) {
            throw "Another autonomous runner is already active with PID $ExistingPid."
        }
    }

    Remove-Item -LiteralPath $LockPath -Force -ErrorAction SilentlyContinue
}

Set-Content -LiteralPath $LockPath -Value $PID -NoNewline

# Keep this prompt short. The durable instructions and state live in repository files.
$ResumePrompt = @"
Resume the EUshop repository-recovery mission autonomously.

First read CLAUDE.md, .claude/AUTONOMY.md, and .claude/RECOVERY_STATE.md. Inspect the current Git branch, HEAD, status, recent commits, worktrees, and existing recovery folders. Continue from the first unfinished checkpoint; do not redo verified work.

Use graceful degradation. When one command, test, dependency, tool, network request, or approach fails, record the failure in .claude/RECOVERY_STATE.md, change method, and continue with independent work. Use simple commands. Never ask for ordinary approvals or ask what to do next. Keep main untouched. Never force-push, deploy, expose secrets, spend money, or alter external accounts.

Update .claude/RECOVERY_STATE.md frequently and before this invocation ends. Create .claude/AUTONOMOUS_COMPLETE only after every mission acceptance criterion is genuinely satisfied. Stop cleanly when .claude/AUTONOMOUS_STOP exists.
"@

$ConsecutiveFailures = 0
$InvocationNumber = 0

try {
    Write-RunnerLog "Wrapper-safe autonomous watchdog started."
    Write-RunnerLog "This version resumes from repository checkpoints instead of relying on --continue."
    Write-RunnerLog "Press Ctrl+C or create $StopPath to stop safely."

    while ($true) {
        if (Test-Path -LiteralPath $StopPath) {
            Write-RunnerLog "Stop marker detected. Exiting cleanly." "WARN"
            break
        }

        if (Test-Path -LiteralPath $CompletePath) {
            Write-RunnerLog "Completion marker detected." "SUCCESS"
            Get-Content -LiteralPath $CompletePath -ErrorAction SilentlyContinue
            break
        }

        $InvocationNumber++
        $InvocationLog = Join-Path $LogDirectory (
            "fixed-invocation-{0:D5}-{1}.log" -f $InvocationNumber, (Get-Date -Format "yyyyMMdd-HHmmss")
        )

        $Fcc = Get-Command "fcc-work" -ErrorAction SilentlyContinue
        if (-not $Fcc) {
            $ConsecutiveFailures++
            $Delay = Get-BackoffSeconds -FailureNumber $ConsecutiveFailures -MaximumSeconds $MaximumBackoffSeconds
            Write-RunnerLog "fcc-work is unavailable. Retrying in $Delay seconds." "ERROR"
            Start-Sleep -Seconds $Delay
            continue
        }

        Write-RunnerLog "Starting FCC invocation $InvocationNumber."

        $Output = @()
        $ExitCode = 1

        try {
            # Minimal, documented CLI form. No --continue, output-format, or max-turns.
            # Every invocation reconstructs context from the repository checkpoint.
            $Output = & fcc-work `
                --dangerously-skip-permissions `
                -p `
                $ResumePrompt `
                2>&1 |
                Tee-Object -FilePath $InvocationLog

            if ($null -eq $LASTEXITCODE) {
                $ExitCode = 0
            }
            else {
                $ExitCode = $LASTEXITCODE
            }
        }
        catch {
            $Output += ($_ | Out-String)
            Add-Content -LiteralPath $InvocationLog -Value ($_ | Out-String)
            $ExitCode = 1
        }

        $Text = $Output | Out-String

        $RateLimited = $Text -match "(?i)(HTTP\s*429|Too Many Requests|rate[_ -]?limit|provider rate limit)"
        $TemporaryFailure = $Text -match "(?i)(timeout|temporar|service unavailable|HTTP\s*5\d\d|ECONN|ETIMEDOUT|connection reset|connection refused)"
        $AuthenticationFailure = $Text -match "(?i)(401|unauthorized|invalid api key|authentication failed)"
        $UnsupportedPrint = $Text -match "(?i)(unknown option|unrecognized option|unexpected argument).*(-p|print)"

        if (Test-Path -LiteralPath $CompletePath) {
            Write-RunnerLog "Claude created the completion marker." "SUCCESS"
            continue
        }

        if (Test-Path -LiteralPath $StopPath) {
            Write-RunnerLog "Stop marker appeared during the invocation." "WARN"
            continue
        }

        if ($RateLimited) {
            $ConsecutiveFailures++
            Write-RunnerLog "FCC provider rate limit detected. Work remains preserved." "WARN"
        }
        elseif ($TemporaryFailure) {
            $ConsecutiveFailures++
            Write-RunnerLog "Temporary FCC or network failure detected." "WARN"
        }
        elseif ($AuthenticationFailure) {
            $ConsecutiveFailures++
            Write-RunnerLog "FCC authentication failed. Check FCC credentials or service health. Retrying without changing providers." "ERROR"
        }
        elseif ($UnsupportedPrint) {
            Write-RunnerLog "The fcc-work wrapper does not forward Claude Code print mode. See: $InvocationLog" "ERROR"
            Write-RunnerLog "Automatic noninteractive looping cannot work through this wrapper until it forwards -p." "ERROR"
            break
        }
        elseif ($ExitCode -ne 0) {
            $ConsecutiveFailures++
            Write-RunnerLog "FCC exited with code $ExitCode. See: $InvocationLog" "ERROR"
        }
        else {
            $ConsecutiveFailures = 0
            Write-RunnerLog "Invocation $InvocationNumber ended normally; continuing from checkpoint."
        }

        if ($ConsecutiveFailures -gt 0) {
            $Delay = Get-BackoffSeconds -FailureNumber $ConsecutiveFailures -MaximumSeconds $MaximumBackoffSeconds
            Write-RunnerLog "Retrying in $Delay seconds. Consecutive failures: $ConsecutiveFailures" "WARN"
            Start-Sleep -Seconds $Delay
        }
        else {
            Start-Sleep -Seconds 5
        }
    }
}
finally {
    Remove-Item -LiteralPath $LockPath -Force -ErrorAction SilentlyContinue
    Write-RunnerLog "Wrapper-safe autonomous watchdog stopped."
}