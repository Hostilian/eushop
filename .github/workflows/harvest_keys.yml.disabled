name: 🔑 Harvest & Validate Free LLM API Keys

# ─────────────────────────────────────────────
# Schedule: every hour on the hour
# Can also be triggered manually via GitHub UI
# ─────────────────────────────────────────────
on:
  schedule:
    - cron: '0 * * * *'     # Every hour at :00
    - cron: '30 * * * *'    # Every hour at :30 (double coverage — if :00 fails, :30 catches it)
  workflow_dispatch:
    inputs:
      workers:
        description: 'Parallel validation workers'
        required: false
        default: '30'
      verbose:
        description: 'Enable verbose logging'
        required: false
        type: boolean
        default: false
      force_harvest:
        description: 'Force harvest even if recent run exists'
        required: false
        type: boolean
        default: false
  push:
    branches: [main]
    paths:
      - 'scripts/harvest_keys.py'   # Re-run when harvester logic changes

permissions:
  contents: write   # Required to commit validated_keys.json back to repo

# Prevent concurrent runs from conflicting on the committed file
concurrency:
  group: harvest-keys
  cancel-in-progress: false  # Don't cancel — let each run complete

jobs:
  harvest:
    name: Harvest + Validate Keys
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      # ── Checkout ─────────────────────────────
      - name: Checkout repository
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          fetch-depth: 1

      # ── Python setup ─────────────────────────
      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install Python dependencies
        run: |
          pip install requests --quiet

      # ── Run harvester (with retry) ────────────────
      - name: Harvest and validate free LLM API keys
        id: harvest
        run: |
          WORKERS="${{ github.event.inputs.workers || '30' }}"
          VERBOSE_FLAG=""
          if [ "${{ github.event.inputs.verbose }}" = "true" ]; then
            VERBOSE_FLAG="--verbose"
          fi

          # First attempt
          echo "=== Attempt 1/3 ==="
          python scripts/harvest_keys.py \
            --output data/validated_keys.json \
            --workers "$WORKERS" \
            $VERBOSE_FLAG || true

          VALID=$(python -c "import json; d=json.load(open('data/validated_keys.json')); print(d.get('total_valid', 0))" 2>/dev/null || echo "0")
          echo "Attempt 1 found $VALID valid keys"

          # Retry if 0 keys (sources may have been slow)
          if [ "$VALID" -eq "0" ]; then
            echo "=== Attempt 2/3 (60s delay, more workers) ==="
            sleep 60
            python scripts/harvest_keys.py \
              --output data/validated_keys.json \
              --workers "50" \
              $VERBOSE_FLAG || true
            VALID=$(python -c "import json; d=json.load(open('data/validated_keys.json')); print(d.get('total_valid', 0))" 2>/dev/null || echo "0")
            echo "Attempt 2 found $VALID valid keys"
          fi

          # Final retry if still 0
          if [ "$VALID" -eq "0" ]; then
            echo "=== Attempt 3/3 (120s delay, max workers) ==="
            sleep 120
            python scripts/harvest_keys.py \
              --output data/validated_keys.json \
              --workers "60" || true
            VALID=$(python -c "import json; d=json.load(open('data/validated_keys.json')); print(d.get('total_valid', 0))" 2>/dev/null || echo "0")
            echo "Attempt 3 found $VALID valid keys"
          fi

          echo "valid_count=$VALID" >> "$GITHUB_OUTPUT"
          echo "::notice title=Key Harvest::Final result: $VALID valid keys"

      # ── Commit back ──────────────────────────
      - name: Commit validated_keys.json
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          
          # Only commit if file changed
          if git diff --quiet data/validated_keys.json; then
            echo "No changes to validated_keys.json — skipping commit"
          else
            git add data/validated_keys.json
            git commit -m "chore(keys): hourly harvest — ${{ steps.harvest.outputs.valid_count }} valid keys [skip ci]"
            git push
            echo "::notice title=Committed::Updated validated_keys.json with ${{ steps.harvest.outputs.valid_count }} valid keys"
          fi

      # ── Upload artifact ──────────────────────
      - name: Upload validated_keys.json as artifact
        uses: actions/upload-artifact@v4
        with:
          name: validated-keys-${{ github.run_number }}
          path: data/validated_keys.json
          retention-days: 2   # Keep last 2 days of artifacts

      # ── Job summary ──────────────────────────
      - name: Write job summary
        run: |
          VALID="${{ steps.harvest.outputs.valid_count }}"
          TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
          
          echo "## 🔑 Key Harvest Summary" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "| Metric | Value |" >> "$GITHUB_STEP_SUMMARY"
          echo "|--------|-------|" >> "$GITHUB_STEP_SUMMARY"
          echo "| Valid Keys Found | **$VALID** |" >> "$GITHUB_STEP_SUMMARY"
          echo "| Timestamp (UTC) | $TIMESTAMP |" >> "$GITHUB_STEP_SUMMARY"
          echo "| Workflow Run | [#${{ github.run_number }}](${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}) |" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          
          if [ "$VALID" -gt 0 ]; then
            echo "✅ **Status**: Active keys available. Pool is healthy." >> "$GITHUB_STEP_SUMMARY"
          else
            echo "⚠️ **Status**: No valid keys found. Sources may be temporarily down." >> "$GITHUB_STEP_SUMMARY"
          fi
          
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "Top models by priority score:" >> "$GITHUB_STEP_SUMMARY"
          python -c "
          import json
          with open('data/validated_keys.json') as f:
              data = json.load(f)
          keys = data.get('keys', [])[:10]
          for i, k in enumerate(keys, 1):
              model = k.get('model', 'unknown')
              base = k.get('working_base_url', '?')
              short_key = k['key'][:12] + '...'
              print(f'- {i}. \`{short_key}\` → **{model}** via {base}')
          " >> "$GITHUB_STEP_SUMMARY" || true

      # ── Alert on zero keys ───────────────────
      - name: Alert if no valid keys found
        if: steps.harvest.outputs.valid_count == '0'
        run: |
          echo "::warning title=No Valid Keys::Harvester found 0 valid keys. All sources may be down. Check source repos."
          # Don't fail the workflow — this is expected during source repo outages
          exit 0
